{
  "name": "pi-tsp",
  "version": "2.0.0",
  "type": "module",
  "description": "A native Tern surface for the pi coding agent: semantic transcript, tool cards, diffs, subagents, approvals, pickers and a real composer over pi's RPC session.",
  "bin": {
    "pi-tsp": "./bin/pi-tsp"
  },
  "files": [
    "bin",
    "dist",
    "ext",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/pi-tsp",
    "test": "npm run build && node --test test/*.test.mjs",
    "build": "tsc -p .",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "pi",
    "tern",
    "tsp",
    "coding-agent",
    "terminal",
    "tui",
    "native-surface"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MadeBy561/pi-tsp.git"
  },
  "homepage": "https://github.com/MadeBy561/pi-tsp#readme",
  "bugs": {
    "url": "https://github.com/MadeBy561/pi-tsp/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@stencil-hq/tern": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
